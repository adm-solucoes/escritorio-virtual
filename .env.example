# Modelo do escritorio-virtual/.env - copie pra `.env` e preencha.
# O .env NAO vai pro git (.gitignore). Este arquivo so tem os NOMES.
# No Render, as mesmas variaveis vao no painel (Environment), nao em arquivo.
# Tudo e opcional: sem uma integracao, a aba dela so mostra "nao configurado".

# ---- Google Agenda (as mesmas credenciais do CRM: crm-adm/.env.local) ----
# No Google Cloud, o cliente OAuth precisa ter este redirect autorizado:
#   http://localhost:3500/api/google/callback        (local)
#   https://escritorio-virtual-adm.onrender.com/api/google/callback   (Render)
# As duas ligam tambem o "Entrar com o Google da ADM" - e com elas preenchidas,
# e-mail da ADM so entra pelo Google (ver docs/plano-login.md, secao 10).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Quem entra com o Google ja como diretoria, separados por virgula.
DIRETORIA_EMAILS=

# ---- Discador do CRM dentro da sede (docs/discador.md) ----
# O endereco do CRM, sem barra no fim, e a chave combinada: a MESMA que vai no
# CRM como DISCADOR_CHAVE_ESCRITORIO. 32 caracteres ou mais - gere com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRM_URL=
CRM_CHAVE_DISCADOR=

# ---- Kanban do CRM: os quadros das diretorias na aba de quadros (docs/plano-kanban-crm.md) ----
# E la que o time trabalha hoje. Usa o MESMO CRM_URL de cima e uma chave PROPRIA (nao a do
# discador): a MESMA que vai no CRM como KANBAN_CHAVE_ESCRITORIO, com 32 caracteres ou mais.
# Cada pessoa ve os quadros que o cargo dela libera no CRM (gestor ve todos).
# (A sede aceita tambem o nome do CRM, KANBAN_CHAVE_ESCRITORIO; se os dois existirem, vale este.)
CRM_CHAVE_KANBAN=

# ---- Trello: os quadros de ANTES do Kanban do CRM (docs/plano-trello.md) ----
# Com o Kanban do CRM ligado, so entram os quadros listados em TRELLO_QUADROS: o
# TRELLO_BOARD_ID de antes (o quadro parado) deixa de aparecer.
# A chave e o token sao os mesmos do CRM (https://trello.com/power-ups/admin). O dono
# do token precisa ser membro de cada quadro.
TRELLO_API_KEY=
TRELLO_TOKEN=
# Os setores, separados por ";" - Nome=quadro, com opcoes depois de "|":
#   quadro          o codigo curto da URL (trello.com/b/AbCdEfGh/...), o id ou o link
#   |etiqueta=A,B   so os cartoes com alguma dessas etiquetas (dois setores num quadro so)
#   |diretoria      so a diretoria ve
# Exemplo:
#   TRELLO_QUADROS="Comercial=AbCdEfGh; Marketing=IjKlMnOp|etiqueta=Marketing; Direx=QrStUvWx|diretoria"
TRELLO_QUADROS=
# Antigo, ainda vale se TRELLO_QUADROS estiver vazio: UM quadro, de todos.
TRELLO_BOARD_ID=

# ---- Biblioteca: pasta de livros no Drive (docs/estante.md) ----
# link da pasta ou so o id
GOOGLE_DRIVE_PASTA=
# JSON da chave da conta de servico, numa linha so, ou em base64
GOOGLE_CONTA_SERVICO=
# Ou a chave num ARQUIVO (vale se a variavel de cima estiver vazia ou invalida). Sem esta, o
# servidor procura /etc/secrets/conta-servico.json - o "Secret File" do Render com esse nome.
GOOGLE_CONTA_SERVICO_ARQUIVO=

# ---- Chamada de video em rede restrita: TURN da Cloudflare (docs/deploy.md, secao 4) ----
# dash.cloudflare.com > Realtime > TURN Server > Create: aparecem os dois valores
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_TOKEN=

# ---- Backup automatico no Drive (docs/backup.md) ----
# drive compartilhado SO de backup, com a conta de servico como "Administrador de conteudo"
BACKUP_DRIVE_PASTA=
# senha que cifra o backup. GUARDE EM LUGAR SEGURO: sem ela, nenhum backup abre.
BACKUP_CHAVE=

# ---- E-mail: confirmar o cadastro e "esqueci minha senha" (docs/email.md) ----
# resend ou brevo (os dois tem plano gratis). Em branco = e-mail desligado:
# cadastro entra na hora e quem esquece a senha pede pra diretoria.
EMAIL_PROVEDOR=
# a API key do provedor
EMAIL_CHAVE=
# endereco num dominio verificado no provedor, ex.: avisos@sedes.admsolucoes.com.br
EMAIL_REMETENTE=
